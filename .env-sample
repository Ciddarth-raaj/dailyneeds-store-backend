IS_TEST=true

# Sandbox (https://developer.sandbox.co.in/) — tax / compliance APIs
SANDBOX_API_KEY=
SANDBOX_API_SECRET=
# Test: https://test-api.sandbox.co.in — Production: https://api.sandbox.co.in
SANDBOX_API_BASE_URL=https://test-api.sandbox.co.in
# Optional; authenticate endpoint defaults to 1.0
# SANDBOX_API_VERSION=1.0
# Optional; GST compliance public endpoints (e.g. GSTIN search) default to 1.0.0 per Sandbox
# SANDBOX_GST_API_VERSION=1.0.0
# Optional; when true, Sandbox GSTIN search sends x-accept-cache: true (not exposed on POST /gst/search)
# SANDBOX_GST_ACCEPT_CACHE=false
# GST taxpayer OTP session: the registration this server files for.
# REQUIRED for GST taxpayer-authenticated calls (OTP, GSTR-2A). Without them the
# server still starts and every non-GST module works; GST taxpayer endpoints
# refuse with a configuration error. Never commit real values.
# GSTIN: 15 chars - 2 digits, 5 letters, 4 digits, letter, alphanumeric, 'Z', alphanumeric.
GST_OWN_GSTIN=
GST_PORTAL_USERNAME=
# Optional, display only; never sent to Sandbox.
# GST_OWN_LEGAL_NAME=
# 30-day session + day-29 revalidation: see docs/gst-taxpayer-session-fe.md

# ---------------------------------------------------------------------------
# Stage 0A authentication (see docs/auth-stage0a-implementation.md)
# Defaults are the Deployment A posture. Nothing below has a committed value.

# JWT keys. Move the key files OUT of the repository on the server, then point
# these at them. JWT_PUBLIC_KEYS is a JSON map of kid -> path: the fixed
# allow-list the verifier resolves `kid` against. Never derived from a token.
# JWT_PRIVATE_KEY_PATH=/etc/dnds/jwt/legacy.key
# JWT_PUBLIC_KEYS={"legacy":"/etc/dnds/jwt/legacy.pub"}
# JWT_ACTIVE_KID=legacy
# JWT_LEGACY_KID=legacy
# JWT_REQUIRE_KID=false
# JWT_TOKEN_LIFETIME=1d

# Telegram bot token - REQUIRED for alerts, break-glass alerts, and the
# password-reset codes sent to a linked chat. No committed fallback exists any
# more (Stage 0A); rotate via BotFather and set it here before deploying.
TELEGRAM_BOT_TOKEN=
# Optional. "Link Telegram" builds a https://t.me/<name>?start=<token> deep
# link, and normally asks the bot for its own @name - the token already says
# which bot it is. Set this only to override that.
# TELEGRAM_BOT_USERNAME=

# Express trust proxy. Default loopback (nginx on this host). Never "true".
# TRUST_PROXY=loopback

# Deployment A flags
# AUTH_LEGACY_QUERY_LOGIN=true      # remove in a hotfix once auth_metric shows 0
# AUTH_REQUIRE_HTTPS=false          # enable after /user/my-ip reports secure:true behind the proxy
# AUTH_SECURITY_ALERT_CHAT_ID=      # Telegram chat for break-glass alerts (default: ALERTS chat)
# AUTH_BREAK_GLASS_ROTATION_DAYS=90

# Deployment B flags
# AUTH_HASH_ON_LOGIN=false
# # Gate 13: flag a proven-weak password at login (default true; enforcement is AUTH_ENFORCE_PASSWORD_CHANGE)
AUTH_FLAG_WEAK_ON_LOGIN=true
# Gate 14: refuse a live session whose employee is no longer active (default true)
AUTH_EMPLOYEE_STATUS_CHECK=true
AUTH_ENFORCE_PASSWORD_CHANGE=false
# AUTH_SECURE_PROVISIONING=false
# AUTH_LOCKOUT_ENABLED=false
# AUTH_LOCKOUT_THRESHOLD=5
# AUTH_LOCKOUT_MINUTES=15
# AUTH_PASSWORD_MIN_LENGTH=8
# AUTH_RESET_TOKEN_MINUTES=30

# Deployment C flags
# AUTH_TOKEN_VALID_FROM_ENABLED=false
# AUTH_REJECT_LEGACY_SHA1=false

# ---------------------------------------------------------------------------
# Biomax BM70W receiver (biomax/receiver.js, pm2 app "biomax-receiver").
# Read by the receiver process only; the API ignores them. All optional.
# BIOMAX_PORT=7005                    # TCP port the devices post to (D2)
# BIOMAX_HOST=0.0.0.0
# BIOMAX_MAX_BODY=65536               # bytes; a real punch is 144
# BIOMAX_SOCKET_TIMEOUT_MS=15000
# BIOMAX_SPOOL_DIR=~/biomax-spool     # frames refused for lack of a DB, for diagnosis
# Flood caps for UNREGISTERED devices only (R13)
# BIOMAX_UNREG_PER_MINUTE=30
# BIOMAX_UNREG_PER_DAY=2000
# BIOMAX_UNREG_DEVICES_PER_DAY=20

# Devices screen: when a terminal counts as Stale / Offline. Measured from
# biomax_device.last_seen_at, which the receiver touches on EVERY request
# (poll or punch) - never from last_punch_at. The BM70W poll interval is a
# setting on the terminal and is not proven anywhere in this repository, so
# these defaults are deliberately loose; tighten them once production
# last_seen_at gaps show the real cadence.
# BIOMAX_DEVICE_STALE_SECONDS=900      # 15 minutes
# BIOMAX_DEVICE_OFFLINE_SECONDS=3600   # 60 minutes
# BIOMAX_HEALTH_TIMEOUT_MS=800         # API -> receiver /healthz probe budget
# BIOMAX_HEALTH_HOST=127.0.0.1         # the receiver is never reached from a browser

# ---------------------------------------------------------------------------
# DigiSME attendance API sync (services/digisme_attendance.js).
#
# REQUIRED on the API host before the sync can run. Without them the live
# cron reports "not configured" every minute and NO ATTENDANCE IS PULLED -
# loud, but only if someone is reading the log. Set them before enabling.
#
# These are NOT the credentials of the removed DigiSME employee sync. Those
# were hard-coded literals, are in git history, and are being revoked
# (docs/digisme-employee-sync-removal.md §4). The attendance integration
# reads its own from the environment and never hard-codes anything.
#
# Values are issued by DigiSME for a whitelisted source IP. Do not commit
# them, do not paste them into a ticket, and do not reuse them anywhere else
# - services/digisme_removal.test.js fails if any file outside the sanctioned
# client references them.
# DIGISME_API_KEY=                    # Authorization header on /Authenticate
# DIGISME_CUSTOM_KEY=                 # customKey header on /Authenticate
# DIGISME_COMPANY_ID=1                # optional; defaults to 1
# DIGISME_BASE_URL=                   # optional; defaults to the live gateway

# DigiSME attendance cron kill switch.
#
# Attendance comes from the direct Biomax receiver. Set to "false" (case
# insensitive, surrounding whitespace ignored) and neither
# digisme_attendance_live (* * * * *) nor digisme_attendance_recovery
# (45 6,12,18,23 * * *) is registered at all, so no DigiSME attendance API
# call and no DigiSME failure alert comes from them. Absent or any other value
# leaves both running, which is the existing behaviour. Affects those two jobs
# only - CRON_DISABLED, every other cron, the direct Biomax receiver and the
# DigiSME import code are untouched. Production sets it to false.
# DIGISME_ATTENDANCE_CRON_ENABLED=false
